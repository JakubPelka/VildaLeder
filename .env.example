# Use either a key value or a path to a file containing it. Never commit the key.
SOS_SUBSCRIPTION_KEY=
SOS_SUBSCRIPTION_KEY_FILE=/absolute/path/to/specieskey.txt

# Local PostGIS development. Use a different secret outside a local machine.
VILDA_DB_PASSWORD=change-me
DATABASE_URL=postgresql://vildaleder:change-me@127.0.0.1:5432/vildaleder
